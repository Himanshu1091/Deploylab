# Copy to .env and fill in. Never commit .env.

# ---- Runtime ----
# development | production
# Controls the cookie `secure` flag and whether stack traces are returned.
NODE_ENV=development
PORT=5000

# ---- Database ----
# Atlas: Connect -> Drivers -> copy the string, then replace <password>
# and append the database name before the query string.
# Example: mongodb+srv://user:pass@cluster0.abcde.mongodb.net/deploylab?retryWrites=true&w=majority
MONGODB_URI=

# ---- Auth ----
# Generate with: openssl rand -hex 32
# Use a different secret in every environment. Changing it invalidates all sessions.
JWT_SECRET=
JWT_EXPIRES_IN=24h

# ---- CORS ----
# Development only. In production the client is served same-origin, so this is unused.
CLIENT_ORIGIN=http://localhost:5173

# ---- Seed script ----
# Used by `npm run seed` to create the initial accounts.
SEED_ADMIN_EMAIL=admin@deploylab.local
SEED_ADMIN_PASSWORD=Admin123pass
SEED_MANAGER_EMAIL=manager@deploylab.local
SEED_MANAGER_PASSWORD=Manager123pass
SEED_EMPLOYEE_EMAIL=employee@deploylab.local
SEED_EMPLOYEE_PASSWORD=Employee123pass
