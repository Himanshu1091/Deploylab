# Copy to .env. Vite only exposes variables prefixed with VITE_.
#
# Note: Vite inlines these at BUILD time, not run time. Changing a value here
# requires a rebuild — it is not read from the environment when the server starts.

# Same value in development and production, because both are same-origin:
# Vite's dev proxy handles it locally, nginx handles it in production.
VITE_API_URL=/api
